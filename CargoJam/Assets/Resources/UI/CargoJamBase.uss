/* Cargo Jam UI, design v3: tokens, type, buttons and shared widgets.
   Sizes are panel units at the 1080x1920 reference (ScaleWithScreenSize, match 0.5).
   C# mirrors the color tokens in UI/Core/UiPalette.cs; keep the two in step. */

.cj-root {
    /* Color */
    --ink: #1E2A3B;
    --ink-2: #4A5869;
    --ink-3: #8A94A1;
    --surface: #FBF7F0;
    --surface-2: #F1EADF;
    --surface-3: #E4DACB;
    --stroke: rgba(30, 42, 59, 0.10);
    --glass: rgba(18, 26, 38, 0.46);
    --glass-stroke: rgba(255, 255, 255, 0.14);
    --on-glass: #FFFFFF;
    --on-glass-2: rgba(255, 255, 255, 0.72);
    --primary: #2FA866;
    --primary-press: #258A53;
    --secondary: #2E3E56;
    --secondary-press: #24324A;
    --gold: #E9B44C;
    --gold-deep: #C8912E;
    --danger: #D9534F;
    --scrim: rgba(12, 18, 28, 0.55);
    --scrim-light: rgba(12, 18, 28, 0.20);
    --elevation: rgba(12, 18, 28, 0.18);

    /* Type scale */
    --fs-display: 96px;
    --fs-title: 64px;
    --fs-heading: 48px;
    --fs-body: 38px;
    --fs-label: 32px;
    --fs-caption: 28px;
    --fs-micro: 24px;

    /* Space: 8 / 16 / 24 / 32 / 48 / 64 */
    --sp-1: 8px;
    --sp-2: 16px;
    --sp-3: 24px;
    --sp-4: 32px;
    --sp-5: 48px;
    --sp-6: 64px;

    -unity-font-definition: resource("UI/Fonts/Nunito-SemiBold SDF");
    font-size: var(--fs-body);
    color: var(--ink);
}

.cj-root .unity-label {
    margin: 0;
    padding: 0;
}

.cj-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.cj-grow {
    flex-grow: 1;
}

.cj-icon {
    flex-shrink: 0;
}

/* ---- Type --------------------------------------------------------------------------------- */

.cj-t-display {
    font-size: var(--fs-display);
    -unity-font-definition: resource("UI/Fonts/Nunito-Black SDF");
    letter-spacing: -1px;
}

.cj-t-title {
    font-size: var(--fs-title);
    -unity-font-definition: resource("UI/Fonts/Nunito-Black SDF");
}

.cj-t-heading {
    font-size: var(--fs-heading);
    -unity-font-definition: resource("UI/Fonts/Nunito-ExtraBold SDF");
}

.cj-t-body {
    font-size: var(--fs-body);
    white-space: normal;
}

.cj-t-label {
    font-size: var(--fs-label);
    -unity-font-definition: resource("UI/Fonts/Nunito-ExtraBold SDF");
}

.cj-t-caption {
    font-size: var(--fs-caption);
    -unity-font-definition: resource("UI/Fonts/Nunito-ExtraBold SDF");
}

.cj-t-micro {
    font-size: var(--fs-micro);
    -unity-font-definition: resource("UI/Fonts/Nunito-Black SDF");
}

.cj-t-center {
    -unity-text-align: middle-center;
}

.cj-c-ink {
    color: var(--ink);
}

.cj-c-ink2 {
    color: var(--ink-2);
}

.cj-c-ink3 {
    color: var(--ink-3);
}

/* Text over glass or the 3D world: white with a soft shadow. Text on surfaces gets none. */
.cj-on-glass {
    color: var(--on-glass);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
}

.cj-on-glass-2 {
    color: var(--on-glass-2);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
}

/* ---- Glass and surfaces ------------------------------------------------------------------- */

.cj-glass {
    background-color: var(--glass);
    border-width: 2px;
    border-color: var(--glass-stroke);
}

.cj-inset {
    background-color: var(--surface-2);
    border-radius: 44px;
}

/* Fake elevation: a dark sibling under a surface, offset down, same radius. */
.cj-elevation {
    position: absolute;
    left: 0;
    right: 0;
    top: 10px;
    bottom: -10px;
    background-color: var(--elevation);
}

/* ---- Buttons ------------------------------------------------------------------------------ */
/* Flat fill with a faint lighter top hairline; press scales to 0.97 and swaps to the -press
   color; release settles on OutQuint. The fill lives on __face so an elevation underlay
   (__shadow, shown with --raised) can sit behind it. */

.cj-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 148px;
    padding: 0 48px;
}

.cj-btn__face,
.cj-btn__shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 50px;
}

.cj-btn__face {
    background-color: var(--secondary);
    border-top-width: 2px;
    border-color: rgba(255, 255, 255, 0.12);
}

.cj-btn__shadow {
    display: none;
    top: 14px;
    bottom: -14px;
    background-color: var(--elevation);
}

.cj-btn--raised > .cj-btn__shadow {
    display: flex;
}

.cj-btn__content {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.cj-btn__icon {
    width: 60px;
    height: 60px;
    margin: 0 8px;
}

.cj-btn__label {
    font-size: var(--fs-heading);
    -unity-font-definition: resource("UI/Fonts/Nunito-Black SDF");
    color: #FFFFFF;
    margin: 0 8px;
    -unity-text-align: middle-center;
}

/* Variants */

.cj-btn--primary > .cj-btn__face {
    background-color: var(--primary);
}

.cj-btn--primary.cj-btn--pressed > .cj-btn__face {
    background-color: var(--primary-press);
}

.cj-btn--secondary > .cj-btn__face {
    background-color: var(--secondary);
}

.cj-btn--secondary.cj-btn--pressed > .cj-btn__face {
    background-color: var(--secondary-press);
}

.cj-btn--quiet > .cj-btn__face {
    background-color: var(--surface-2);
    border-width: 2px;
    border-color: var(--stroke);
}

.cj-btn--quiet.cj-btn--pressed > .cj-btn__face {
    background-color: var(--surface-3);
}

.cj-btn--quiet .cj-btn__label {
    color: var(--ink);
    -unity-font-definition: resource("UI/Fonts/Nunito-ExtraBold SDF");
}

.cj-btn--glass > .cj-btn__face {
    background-color: var(--glass);
    border-width: 2px;
    border-color: var(--glass-stroke);
}

.cj-btn--glass.cj-btn--pressed > .cj-btn__face {
    background-color: rgba(18, 26, 38, 0.62);
}

.cj-btn--glass .cj-btn__label {
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
}

.cj-btn--greyed > .cj-btn__face,
.cj-btn--greyed.cj-btn--pressed > .cj-btn__face {
    background-color: var(--surface-3);
    border-width: 0;
}

.cj-btn--greyed .cj-btn__label {
    color: var(--ink-3);
}

/* Sizes */

.cj-btn--l {
    height: 168px;
    padding: 0 56px;
}

.cj-btn--l > .cj-btn__face,
.cj-btn--l > .cj-btn__shadow {
    border-radius: 56px;
}

.cj-btn--l .cj-btn__label {
    font-size: var(--fs-title);
}

.cj-btn--m {
    height: 148px;
}

.cj-btn--s {
    height: 116px;
    padding: 0 40px;
}

.cj-btn--s > .cj-btn__face {
    border-radius: 40px;
}

.cj-btn--s .cj-btn__label {
    font-size: var(--fs-body);
}

.cj-btn--s .cj-btn__icon {
    width: 48px;
    height: 48px;
}

.cj-btn--wide {
    align-self: stretch;
}

.cj-btn--icon {
    width: 122px;
    height: 122px;
    padding: 0;
}

.cj-btn--icon > .cj-btn__face {
    border-radius: 61px;
}

.cj-btn--icon .cj-btn__icon {
    width: 54px;
    height: 54px;
    margin: 0;
}

/* Rounded-square glass icon (home edge column). */
.cj-btn--tile {
    width: 128px;
    height: 128px;
    padding: 0;
}

.cj-btn--tile > .cj-btn__face {
    border-radius: 40px;
}

.cj-btn--tile .cj-btn__icon {
    width: 74px;
    height: 74px;
    margin: 0;
}

.cj-btn--close {
    position: absolute;
    top: 40px;
    right: 40px;
    width: 96px;
    height: 96px;
    padding: 0;
}

.cj-btn--close > .cj-btn__face {
    border-radius: 48px;
    background-color: var(--surface-2);
    border-width: 0;
}

.cj-btn--close.cj-btn--pressed > .cj-btn__face {
    background-color: var(--surface-3);
}

.cj-btn--close .cj-btn__icon {
    width: 34px;
    height: 34px;
    margin: 0;
}

/* A coin price inside a button: "(coin) 300" on a darker pill. */
.cj-price {
    flex-direction: row;
    align-items: center;
    height: 84px;
    margin-left: 24px;
    padding: 0 28px 0 14px;
    border-radius: 42px;
    background-color: rgba(12, 18, 28, 0.22);
}

.cj-price__coin {
    width: 48px;
    height: 48px;
    margin-right: 10px;
}

.cj-price__label {
    font-size: 42px;
    -unity-font-definition: resource("UI/Fonts/Nunito-Black SDF");
    color: #FFFFFF;
}

.cj-btn--greyed .cj-price {
    background-color: rgba(30, 42, 59, 0.08);
}

.cj-btn--greyed .cj-price__label {
    color: var(--ink-3);
}

/* ---- Chips, coin pill, tags, dots --------------------------------------------------------- */

.cj-chip {
    flex-direction: row;
    align-items: center;
    height: 100px;
    padding: 0 44px;
    border-radius: 50px;
}

.cj-chip__label {
    font-size: 44px;
    -unity-font-definition: resource("UI/Fonts/Nunito-ExtraBold SDF");
}

.cj-top__row {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding: 0 44px;
}

.cj-coins {
    flex-direction: row;
    align-items: center;
    height: 100px;
    min-width: 230px;
    padding: 0 40px 0 16px;
    border-radius: 50px;
}

.cj-coins__icon {
    width: 66px;
    height: 66px;
    margin-right: 20px;
}

.cj-coins__label {
    font-size: 44px;
    -unity-font-definition: resource("UI/Fonts/Nunito-ExtraBold SDF");
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.cj-tag {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 60px;
    padding: 0 22px;
    margin-left: 20px;
    border-radius: 30px;
    background-color: var(--danger);
}

.cj-tag__label {
    font-size: var(--fs-micro);
    -unity-font-definition: resource("UI/Fonts/Nunito-Black SDF");
    color: #FFFFFF;
    letter-spacing: 1px;
}

/* Streak tier chip ("(flame) ×1.5"): ink on surfaces, a dark wash on the primary button. */
.cj-tier {
    flex-direction: row;
    align-items: center;
    height: 80px;
    padding: 0 26px 0 18px;
    border-radius: 40px;
    background-color: var(--ink);
}

.cj-tier--on-primary {
    background-color: rgba(12, 18, 28, 0.22);
}

.cj-tier__icon {
    width: 40px;
    height: 40px;
    margin-right: 8px;
}

.cj-tier__label {
    font-size: 38px;
    -unity-font-definition: resource("UI/Fonts/Nunito-Black SDF");
    color: var(--gold);
}

.cj-tier--on-primary .cj-tier__label {
    color: #FFFFFF;
}

.cj-dot {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    border-width: 5px;
    border-color: var(--ink);
    background-color: var(--gold);
}

/* ---- Progress bar ------------------------------------------------------------------------- */

.cj-bar {
    height: 22px;
    border-radius: 11px;
    background-color: var(--stroke);
    overflow: hidden;
}

.cj-bar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-radius: 11px;
    background-color: var(--primary);
}

.cj-bar--gold .cj-bar__fill {
    background-color: var(--gold);
}

/* ---- Switch ------------------------------------------------------------------------------- */

.cj-switch {
    width: 148px;
    height: 84px;
    border-radius: 42px;
    flex-shrink: 0;
    background-color: var(--surface-3);
}

.cj-switch--on {
    background-color: var(--primary);
}

.cj-switch__knob {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 68px;
    height: 68px;
    border-radius: 34px;
    background-color: #FFFFFF;
}

/* ---- Fly-ins ------------------------------------------------------------------------------ */

.cj-flyer {
    position: absolute;
    left: 0;
    top: 0;
}

.cj-spark {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 50px;
}

/* ---- Modals: card, bottom card, sheet ----------------------------------------------------- */

.cj-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.cj-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--scrim);
}

.cj-scrim--light {
    background-color: var(--scrim-light);
}

.cj-frame {
    width: 920px;
}

.cj-frame > .cj-elevation {
    border-radius: 72px;
}

.cj-panel {
    align-items: center;
    background-color: var(--surface);
    border-radius: 72px;
    padding: 72px 56px 56px 56px;
}

.cj-panel__title {
    font-size: var(--fs-title);
    -unity-font-definition: resource("UI/Fonts/Nunito-Black SDF");
    color: var(--ink);
    -unity-text-align: middle-center;
    margin: 0 96px 8px 96px;
}

.cj-panel__body {
    width: 100%;
    align-items: center;
    padding-top: 16px;
}

/* Bottom card (win): floats above the bottom edge. */
.cj-modal--bottom {
    justify-content: flex-end;
}

.cj-frame--bottom {
    width: auto;
    align-self: stretch;
    margin: 0 56px;
}

/* Sheet (fail): edge to edge from the bottom, at most 45% of the screen. */
.cj-modal--sheet {
    justify-content: flex-end;
}

.cj-frame--sheet {
    width: auto;
    align-self: stretch;
    max-height: 45%;
}

.cj-frame--sheet > .cj-elevation {
    display: none;
}

.cj-frame--sheet > .cj-panel {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    padding: 28px 64px 48px 64px;
}

.cj-sheet__grabber {
    width: 110px;
    height: 14px;
    border-radius: 7px;
    margin-bottom: 32px;
    background-color: var(--stroke);
}

.cj-popup__text {
    max-width: 780px;
    margin: 16px 0 8px 0;
    font-size: var(--fs-body);
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--ink-2);
}

.cj-popup__note {
    margin-top: 20px;
    font-size: var(--fs-caption);
    -unity-font-definition: resource("UI/Fonts/Nunito-ExtraBold SDF");
    -unity-text-align: middle-center;
    color: var(--ink-3);
}

.cj-popup__actions {
    align-self: stretch;
    margin-top: 40px;
}

.cj-popup__actions > .cj-btn {
    margin-top: 24px;
}

/* ---- Toast -------------------------------------------------------------------------------- */

.cj-toast {
    align-self: center;
    margin-top: 16px;
    padding: 22px 44px;
    border-radius: 50px;
}

.cj-toast__label {
    font-size: 36px;
    -unity-font-definition: resource("UI/Fonts/Nunito-ExtraBold SDF");
    -unity-text-align: middle-center;
}
