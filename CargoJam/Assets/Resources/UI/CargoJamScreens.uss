/* Cargo Jam UI, design v3: screens and popups. Tokens live on .cj-root (CargoJamBase.uss). */

/* ---- Launch splash ------------------------------------------------------------------------ */

.cj-splash {
    display: none;
    align-items: center;
    justify-content: center;
    background-color: var(--ink);
}

.cj-logo {
    align-items: center;
}

.cj-logo__word {
    font-size: 150px;
    -unity-font-definition: resource("UI/Fonts/Nunito-Black SDF");
    letter-spacing: -2px;
}

.cj-logo__tiles {
    flex-direction: row;
    margin-top: 28px;
}

.cj-logo__tile {
    width: 56px;
    height: 56px;
    margin: 0 10px;
    border-radius: 14px;
}

/* ---- Home --------------------------------------------------------------------------------- */

.cj-home__shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 52%;
}

.cj-home__top {
    flex-direction: row;
    align-items: center;
    padding: 0 44px;
}

/* Left-edge column of claimable rewards (Daily, Chest), vertically centered. */
.cj-home__edge {
    position: absolute;
    left: 44px;
    top: 36%;
}

.cj-home__edge > .cj-btn {
    margin-bottom: 32px;
}

.cj-home__bottom {
    padding: 0 56px 64px 56px;
}

.cj-home__name {
    margin-top: 4px;
    white-space: normal;
}

.cj-home__strip {
    margin-top: 40px;
}

.cj-home__play {
    margin-top: 40px;
}

.cj-home__tier {
    position: absolute;
    right: 40px;
    top: 44px;
}

.cj-home__hard {
    position: absolute;
    left: 40px;
    top: 54px;
    margin-left: 0;
}

/* Journey strip (a glass button): dots, caption, chevron. */
.cj-strip {
    height: 150px;
    padding: 0 40px;
}

.cj-strip > .cj-btn__face {
    border-radius: 50px;
}

.cj-strip > .cj-btn__content {
    flex-grow: 1;
    justify-content: flex-start;
}

.cj-strip__dots {
    flex-direction: row;
    align-items: center;
}

.cj-strip__dot {
    width: 22px;
    height: 22px;
    margin-right: 14px;
    border-radius: 11px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.30);
}

.cj-strip__dot--done {
    background-color: var(--gold);
}

.cj-strip__dot--finale {
    background-color: rgba(217, 83, 79, 0.85);
}

.cj-strip__dot--current {
    width: 50px;
    height: 50px;
    border-radius: 25px;
    background-color: #FFFFFF;
}

.cj-strip__truck {
    width: 36px;
    height: 36px;
}

.cj-strip__caption {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 18px;
    font-size: 38px;
    -unity-font-definition: resource("UI/Fonts/Nunito-ExtraBold SDF");
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cj-strip__chevron {
    width: 40px;
    height: 40px;
}

/* ---- Journey screen ----------------------------------------------------------------------- */

.cj-journey {
    background-color: var(--surface-2);
}

.cj-journey__column {
    align-self: center;
}

.cj-journey__header {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
}

.cj-journey__band {
    background-color: var(--surface-2);
}

.cj-journey__row {
    flex-direction: row;
    align-items: center;
    padding: 0 44px;
}

.cj-journey__titles {
    margin-left: 32px;
}

.cj-journey__fade {
    height: 90px;
}

.cj-journey__marker {
    position: absolute;
    width: 150px;
    height: 150px;
}

.cj-journey__marker > .cj-elevation {
    border-radius: 75px;
}

.cj-journey__marker-disc {
    width: 150px;
    height: 150px;
    border-radius: 75px;
    border-width: 6px;
    border-color: var(--primary);
    align-items: center;
    justify-content: center;
    background-color: var(--surface);
}

.cj-journey__marker-icon {
    width: 104px;
    height: 104px;
}

.cj-postcard {
    position: absolute;
}

.cj-postcard > .cj-elevation {
    border-radius: 56px;
}

.cj-postcard__card {
    flex-grow: 1;
    border-radius: 56px;
    padding: 20px;
    background-color: var(--surface);
}

.cj-postcard--current .cj-postcard__card {
    border-width: 6px;
    border-color: var(--primary);
    padding: 14px;
}

.cj-postcard__frame {
    flex-grow: 1;
    border-radius: 40px;
    overflow: hidden;
    background-color: var(--surface-2);
}

.cj-postcard__art {
    flex-grow: 1;
}

.cj-postcard__text {
    padding: 22px 16px 10px 16px;
}

.cj-postcard--locked .cj-postcard__card {
    background-color: var(--surface);
    opacity: 0.85;
}

.cj-postcard__stamp {
    position: absolute;
    top: -30px;
    right: -26px;
}

.cj-stamp {
    width: 140px;
    height: 140px;
}

/* ---- In-level HUD ------------------------------------------------------------------------- */

.cj-hud__top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 44px;
}

.cj-hud__level {
    padding: 0 40px;
}

.cj-hud__hard {
    margin-left: 18px;
    height: 56px;
}

/* Keeps the level chip centered: the coin pill (top layer) occupies this spot. */
.cj-hud__coin-space {
    width: 230px;
}

.cj-hud__bottom {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding-bottom: 30px;
}

/* ---- Booster discs ------------------------------------------------------------------------ */

.cj-booster {
    width: 156px;
    height: 156px;
    margin: 0 30px;
    align-items: center;
    justify-content: center;
}

.cj-btn--disc {
    width: 156px;
    height: 156px;
    padding: 0;
}

.cj-btn--disc > .cj-btn__face {
    border-radius: 78px;
}

.cj-btn--disc .cj-btn__icon {
    width: 70px;
    height: 70px;
    margin: 0;
}

.cj-booster--locked .cj-btn__icon,
.cj-booster--unusable .cj-btn__icon {
    opacity: 0.4;
}

.cj-booster--armed .cj-btn--disc > .cj-btn__face {
    background-color: var(--surface);
    border-color: var(--surface);
}

.cj-booster__ring {
    position: absolute;
    left: -10px;
    top: -10px;
    width: 176px;
    height: 176px;
    border-radius: 88px;
    border-width: 6px;
    border-color: #FFFFFF;
}

.cj-booster__badge {
    position: absolute;
    top: -8px;
    right: -8px;
    min-width: 60px;
    height: 60px;
    padding: 0 16px;
    align-items: center;
    justify-content: center;
    border-radius: 30px;
    background-color: var(--surface);
}

.cj-booster__badge-label {
    font-size: 32px;
    -unity-font-definition: resource("UI/Fonts/Nunito-Black SDF");
    color: var(--ink);
}

.cj-booster--free .cj-booster__badge {
    background-color: var(--gold);
}

.cj-booster__chip {
    position: absolute;
    left: -40px;
    right: -40px;
    bottom: -28px;
    flex-direction: row;
    justify-content: center;
}

.cj-booster__pill {
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding: 0 20px 0 12px;
    border-radius: 28px;
    background-color: var(--surface);
}

.cj-booster__chip-icon {
    width: 32px;
    height: 32px;
    margin-right: 8px;
}

.cj-booster__chip-label {
    font-size: 30px;
    -unity-font-definition: resource("UI/Fonts/Nunito-Black SDF");
    color: var(--ink);
}

/* ---- Hard-level notice -------------------------------------------------------------------- */

.cj-hard-banner {
    align-self: center;
    flex-direction: row;
    align-items: center;
    margin-top: 24px;
    padding: 28px 48px 28px 32px;
    border-radius: 56px;
}

.cj-hard-banner__tag {
    margin-left: 0;
    margin-right: 28px;
}

/* ---- Tutorial ----------------------------------------------------------------------------- */

.cj-hand {
    position: absolute;
    left: 0;
    top: 0;
}

.cj-tip {
    align-self: center;
    flex-direction: row;
    align-items: center;
    max-width: 960px;
    margin: 24px 44px 0 44px;
    padding: 28px 40px 28px 28px;
    border-radius: 48px;
    background-color: var(--surface);
}

.cj-tip__badge {
    height: 60px;
    padding: 0 22px;
    margin-right: 24px;
    justify-content: center;
    border-radius: 30px;
    background-color: var(--surface-2);
}

.cj-tip__badge-label {
    font-size: var(--fs-micro);
    -unity-font-definition: resource("UI/Fonts/Nunito-Black SDF");
    color: var(--ink-2);
}

.cj-tip__label {
    flex-shrink: 1;
    font-size: var(--fs-body);
    white-space: normal;
    color: var(--ink);
}

/* ---- Win card ----------------------------------------------------------------------------- */

.cj-win__caption {
    -unity-text-align: middle-center;
}

.cj-win__reward {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
}

.cj-win__coin {
    width: 110px;
    height: 110px;
    margin-right: 24px;
}

.cj-win__coins {
    font-size: 110px;
    -unity-font-definition: resource("UI/Fonts/Nunito-Black SDF");
    color: var(--ink);
}

.cj-win__tier {
    margin-left: 28px;
}

.cj-win__progress {
    align-self: stretch;
    margin-top: 40px;
    padding: 36px 44px 40px 44px;
}

.cj-win__row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
}

.cj-win__row--gap {
    margin-top: 36px;
}

.cj-win__postcard {
    flex-direction: row;
    align-items: center;
    margin-top: 28px;
}

.cj-win__stamp {
    width: 76px;
    height: 76px;
    margin-right: 18px;
}

.cj-win__next-wrap {
    align-self: stretch;
    margin-top: 44px;
}

/* ---- Fail sheet --------------------------------------------------------------------------- */

.cj-fail__left {
    margin-top: 4px;
}

.cj-fail__continue-label {
    font-size: 54px;
}

.cj-fail__poor {
    margin-top: 14px;
}

/* ---- Pause / settings --------------------------------------------------------------------- */

.cj-settings {
    align-self: stretch;
    margin-top: 16px;
    padding: 8px 0;
}

.cj-settings__row {
    flex-direction: row;
    align-items: center;
    height: 132px;
    padding: 0 40px;
}

.cj-settings__rule {
    height: 2px;
    margin: 0 40px;
    background-color: var(--stroke);
}

.cj-settings__icon {
    width: 60px;
    height: 60px;
}

.cj-settings__label {
    margin-left: 28px;
}

.cj-pause__row {
    flex-direction: row;
    justify-content: space-between;
    margin: 24px -12px 0 -12px;
}

.cj-pause__half {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 12px;
    padding: 0 20px;
}

.cj-pause__row .cj-btn__label {
    font-size: 44px;
}

/* ---- Booster disc (buy / unlock) ---------------------------------------------------------- */

.cj-booster-disc {
    width: 220px;
    height: 220px;
    margin: 16px 0;
    align-items: center;
    justify-content: center;
    border-radius: 110px;
    background-color: var(--surface-2);
}

.cj-booster-disc__icon {
    width: 110px;
    height: 110px;
}

.cj-booster-disc--big {
    width: 260px;
    height: 260px;
    border-radius: 130px;
}

.cj-booster-disc--big .cj-booster-disc__icon {
    width: 130px;
    height: 130px;
}

.cj-unlock__name {
    margin-top: 8px;
}

.cj-unlock__gift {
    flex-direction: row;
    align-items: center;
    margin-top: 20px;
    padding: 18px 36px;
}

.cj-unlock__gift-icon {
    width: 60px;
    height: 60px;
    margin-right: 18px;
}

/* ---- Chest -------------------------------------------------------------------------------- */

.cj-chest__stage {
    width: 520px;
    height: 400px;
    align-items: center;
    justify-content: center;
}

.cj-chest__rays {
    position: absolute;
    left: -60px;
    top: -120px;
    width: 640px;
    height: 640px;
}

.cj-chest__icon {
    width: 290px;
    height: 290px;
}

.cj-chest__icon--big {
    width: 350px;
    height: 350px;
}

.cj-chest__hint {
    margin-top: 8px;
}

.cj-chest__rewards {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 16px;
}

.cj-reward {
    align-items: center;
    margin: 0 18px;
}

.cj-reward__disc {
    width: 140px;
    height: 140px;
    align-items: center;
    justify-content: center;
    border-radius: 70px;
    background-color: var(--surface-2);
}

.cj-reward__icon {
    width: 88px;
    height: 88px;
}

.cj-reward__label {
    margin-top: 10px;
}

/* ---- Daily reward ------------------------------------------------------------------------- */

.cj-daily__streak {
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.cj-daily__grid {
    align-self: stretch;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.cj-daily__cell {
    width: 176px;
    height: 220px;
    margin: 10px;
    padding: 18px 0;
    align-items: center;
    justify-content: space-between;
    border-radius: 36px;
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--surface-2);
}

.cj-daily__cell--chest {
    width: 372px;
}

.cj-daily__cell--claimed {
    opacity: 0.55;
}

.cj-daily__cell--today {
    border-color: var(--gold);
    background-color: var(--surface);
}

.cj-daily__icon {
    width: 84px;
    height: 84px;
}

.cj-daily__check {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    border-radius: 32px;
    background-color: rgba(47, 168, 102, 0.78);
}

.cj-daily__check-icon {
    width: 76px;
    height: 76px;
}
