<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the game's real CargoJam.Core sources, so the generator can never drift from the rules. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AssemblyName>levelgen</AssemblyName>
    <RootNamespace>CargoJam.LevelGen</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../CargoJam/Assets/Scripts/Core/**/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
